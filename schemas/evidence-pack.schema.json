{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gsal/evidence-pack.schema.json",
  "title": "E16 evidence pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "class_number",
    "class_title",
    "research_questions",
    "claims",
    "sources",
    "datasets",
    "uncertainties",
    "prohibited_claims"
  ],
  "properties": {
    "class_number": {"type": "integer", "minimum": 1, "maximum": 8},
    "class_title": {"type": "string", "minLength": 1},
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "source_ids", "confidence", "limitations"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
          "claim": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]},
          "limitations": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "author_or_org", "date", "url", "access_date", "source_type", "license", "scope", "limitations"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "author_or_org": {"type": "string", "minLength": 1},
          "date": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "access_date": {"type": "string", "format": "date"},
          "source_type": {"enum": ["primary_research", "official_documentation", "government", "university", "standards", "review", "textbook", "practitioner"]},
          "license": {"type": "string"},
          "scope": {"type": "string"},
          "limitations": {"type": "string"}
        }
      }
    },
    "datasets": {"type": "array", "items": {"type": "object"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "prohibited_claims": {"type": "array", "items": {"type": "string"}}
  }
}
