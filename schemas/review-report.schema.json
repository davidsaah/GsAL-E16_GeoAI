{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gsal/review-report.schema.json",
  "title": "E16 independent review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "class_number",
    "reviewer",
    "model_family",
    "recommendation",
    "scores",
    "findings",
    "tested_artifacts"
  ],
  "properties": {
    "class_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "enum": [
        "PASS",
        "REVISE",
        "BLOCK"
      ]
    },
    "scores": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "artifact",
          "location",
          "problem",
          "required_correction",
          "acceptance_evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FND-[0-9]{3,}$"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "suggestion"
            ]
          },
          "artifact": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "required_correction": {
            "type": "string"
          },
          "acceptance_evidence": {
            "type": "string"
          },
          "governing_source": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "artifact_revision": {
            "type": "string"
          },
          "revision_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tested_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_id",
        "purpose",
        "builder_model_family",
        "independence",
        "surfaces"
      ],
      "properties": {
        "cycle_id": {
          "type": "string"
        },
        "purpose": {
          "enum": [
            "formative",
            "formal_final"
          ]
        },
        "builder_model_family": {
          "type": "string"
        },
        "independence": {
          "enum": [
            "different_primary_family",
            "same_family_advisory",
            "unavailable"
          ]
        },
        "surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "metadata",
              "full_text",
              "structure",
              "pixels",
              "tool_run",
              "simulation",
              "human"
            ]
          }
        }
      }
    }
  }
}

