# Copy this file to .env on the dedicated host. Never commit the completed .env file.

N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Los_Angeles

POSTGRES_DB=course_factory
POSTGRES_USER=course_factory
POSTGRES_PASSWORD=replace-with-a-long-random-value

OLLAMA_BASE_URL=http://ollama:11434
QDRANT_URL=http://qdrant:6333

# Configure actual provider credentials through the encrypted n8n credential store.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google Drive identifiers contain no credentials but may still reveal internal structure.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_STAGING_FOLDER_ID=
GOOGLE_DRIVE_REVIEW_FOLDER_ID=
GOOGLE_DRIVE_APPROVED_FOLDER_ID=
GOOGLE_DRIVE_PUBLISHED_FOLDER_ID=

# Optional private hostname presented through Tailscale Serve.
TAILSCALE_HOSTNAME=geoai-course-factory
